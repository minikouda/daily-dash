{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "proposals", "retire"],
  "properties": {
    "summary": {"type": "string"},
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "scope", "rationale", "evidence"],
        "properties": {
          "text": {"type": "string"},
          "scope": {"type": "string", "enum": ["todos", "packages", "highlights", "general"]},
          "rationale": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "retire": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "reason"],
        "properties": {
          "rule_id": {"type": "integer"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
